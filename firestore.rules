rules_version = '2';

// Security Rules для Cloud Firestore (неделя 8).
//
// Все данные пользователя лежат в users/{uid}/...:
//   users/{uid}/habits/{id}, entries/{habitId|date}, categories/{id},
//   goals/{id}, metrics/{id}, metric_rules/{habitId|metricId},
//   devices/{fcmToken}
// Читать и писать можно только свои документы.
service cloud.firestore {
  match /databases/{database}/documents {

    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    // Документ синхронизируемой коллекции: {u: время (мс), d: удалён, v: данные}.
    function isSyncRecord() {
      let data = request.resource.data;
      return data.keys().hasAll(['u', 'd'])
        && data.u is int
        && data.d is bool
        && (!('v' in data) || data.v is map)
        && request.resource.size() < 64 * 1024;
    }

    match /users/{uid} {
      allow read, write: if isOwner(uid);

      match /devices/{token} {
        allow read, write: if isOwner(uid);
      }

      match /{collection}/{docId} {
        allow read, delete: if isOwner(uid);
        allow create, update: if isOwner(uid)
          && collection in ['habits', 'entries', 'categories', 'goals',
                            'metrics', 'metric_rules', 'places']
          && isSyncRecord();
      }
    }

    // Всё остальное закрыто.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
